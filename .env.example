# Copy this file to .env and fill in the values.

# MySQL connection string, e.g. mysql://user:password@localhost:3306/issue_tracker
DATABASE_URL=

# Base URL of the app, e.g. http://localhost:3000
NEXTAUTH_URL=

# Random secret for NextAuth, e.g. `openssl rand -base64 32`
NEXTAUTH_SECRET=

# Google OAuth client (Google Cloud Console -> APIs & Services -> Credentials)
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
